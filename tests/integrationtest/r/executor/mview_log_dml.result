use test;
drop table if exists t_mlog_dml;
drop table if exists `$mlog$t_mlog_dml`;
create table t_mlog_dml (id int primary key, uk int unique, v int, extra int);
create materialized view log on t_mlog_dml (id, uk, v);
insert into t_mlog_dml values (1,10,100,1000);
select id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t_mlog_dml` order by id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW`;
id	uk	v	_MLOG$_DML_TYPE	_MLOG$_OLD_NEW
1	10	100	I	1
delete from `$mlog$t_mlog_dml`;
update t_mlog_dml set v=101 where id=1;
select id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t_mlog_dml` order by id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW`;
id	uk	v	_MLOG$_DML_TYPE	_MLOG$_OLD_NEW
1	10	100	U	-1
1	10	101	U	1
delete from `$mlog$t_mlog_dml`;
update t_mlog_dml set extra=2000 where id=1;
select count(*) from `$mlog$t_mlog_dml`;
count(*)
0
delete from `$mlog$t_mlog_dml`;
delete from t_mlog_dml where id=1;
select id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t_mlog_dml` order by id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW`;
id	uk	v	_MLOG$_DML_TYPE	_MLOG$_OLD_NEW
1	10	101	D	-1
drop table if exists t_mlog_replace_dml;
drop table if exists `$mlog$t_mlog_replace_dml`;
create table t_mlog_replace_dml (id int primary key, uk int unique, v int);
insert into t_mlog_replace_dml values (1,10,100), (2,20,200);
create materialized view log on t_mlog_replace_dml (id, uk, v);
replace into t_mlog_replace_dml values (1,20,999);
select id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t_mlog_replace_dml` order by id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW`;
id	uk	v	_MLOG$_DML_TYPE	_MLOG$_OLD_NEW
1	10	100	R	-1
1	20	999	R	1
2	20	200	R	-1
drop table if exists t_mlog_load_dml;
drop table if exists `$mlog$t_mlog_load_dml`;
create table t_mlog_load_dml (id int primary key, uk int unique, v int);
insert into t_mlog_load_dml values (1,10,100);
create materialized view log on t_mlog_load_dml (id, uk, v);
load data local infile './t/executor/mview_log_dml.tsv' ignore into table t_mlog_load_dml fields terminated by '\t' lines terminated by '\n' (id, uk, v);
select id, uk, v from t_mlog_load_dml order by id;
id	uk	v
1	10	100
3	30	333
select id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t_mlog_load_dml` order by id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW`;
id	uk	v	_MLOG$_DML_TYPE	_MLOG$_OLD_NEW
3	30	333	L	1
drop table if exists t_mlog_update_pk;
drop table if exists `$mlog$t_mlog_update_pk`;
create table t_mlog_update_pk (id int primary key, v int);
insert into t_mlog_update_pk values (1, 100);
create materialized view log on t_mlog_update_pk (id, v);
update t_mlog_update_pk set id = 2 where id = 1;
select id, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t_mlog_update_pk` order by id, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW`;
id	v	_MLOG$_DML_TYPE	_MLOG$_OLD_NEW
1	100	U	-1
2	100	U	1
drop table if exists t_mlog_iodku;
drop table if exists `$mlog$t_mlog_iodku`;
create table t_mlog_iodku (id int primary key, uk int unique, v int);
insert into t_mlog_iodku values (1, 10, 100);
create materialized view log on t_mlog_iodku (id, uk, v);
insert into t_mlog_iodku values (1, 10, 101) on duplicate key update v=values(v);
select id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t_mlog_iodku` order by id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW`;
id	uk	v	_MLOG$_DML_TYPE	_MLOG$_OLD_NEW
1	10	100	U	-1
1	10	101	U	1
delete from `$mlog$t_mlog_iodku`;
insert into t_mlog_iodku values (1, 10, 200) on duplicate key update id = 3, v = values(v);
select id, uk, v from t_mlog_iodku order by id;
id	uk	v
3	10	200
select id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t_mlog_iodku` order by id, uk, v, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW`;
id	uk	v	_MLOG$_DML_TYPE	_MLOG$_OLD_NEW
1	10	101	U	-1
3	10	200	U	1
