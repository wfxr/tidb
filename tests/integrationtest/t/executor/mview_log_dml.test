# TestMViewLogDMLInsert
drop table if exists t;
create table t (a int primary key, b int, c int);
create materialized view log on t (a, b);
insert into t values (1, 10, 100);
select a, b, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t` order by a, `_MLOG$_OLD_NEW`;

# TestMViewLogDMLDelete
delete from `$mlog$t`;
delete from t where a = 1;
select a, b, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t` order by a;

# TestMViewLogDMLUpdateRecordedCol
insert into t values (1, 10, 100);
delete from `$mlog$t`;
update t set b = 20 where a = 1;
select a, b, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t` order by `_MLOG$_OLD_NEW`;

# TestMViewLogDMLUpdateNonRecordedCol
delete from `$mlog$t`;
update t set c = 200 where a = 1;
select count(*) from `$mlog$t`;

# TestMViewLogDMLODKUInsertBranch
delete from t;
delete from `$mlog$t`;
insert into t values (2, 20, 200) on duplicate key update b = b + 1;
select a, b, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t` order by `_MLOG$_OLD_NEW`;

# TestMViewLogDMLODKUUpdateBranch
delete from `$mlog$t`;
insert into t values (2, 20, 200) on duplicate key update b = b + 1;
select a, b, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t` order by `_MLOG$_OLD_NEW`;

# TestMViewLogDMLReplaceRecordedCol
delete from t;
delete from `$mlog$t`;
insert into t values (3, 30, 300);
delete from `$mlog$t`;
replace into t values (3, 40, 400);
select a, b, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t` order by `_MLOG$_OLD_NEW`;

# TestMViewLogDMLReplaceNonRecordedCol
delete from `$mlog$t`;
replace into t values (3, 40, 500);
select a, b, `_MLOG$_DML_TYPE`, `_MLOG$_OLD_NEW` from `$mlog$t` order by `_MLOG$_OLD_NEW`;

# Cleanup
drop table if exists `$mlog$t`;
drop table if exists t;
